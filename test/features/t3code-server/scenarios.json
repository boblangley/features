{
  "t3code-server-custom-options": {
    "image": "ghcr.io/wyrd-company/devcontainers/base:noble",
    "features": {
      "t3code-server": {
        "port": "4123",
        "host": "127.0.0.1",
        "serviceUser": "root"
      }
    }
  },
  "t3code-server-caddy": {
    "image": "ghcr.io/wyrd-company/devcontainers/base:noble",
    "features": {
      "t3code-server": {
        "port": "4123",
        "dnsName": "t3.test-container.example.test"
      },
      "caddy": {}
    }
  },
  "t3code-server-fork-package-source": {
    "image": "ghcr.io/wyrd-company/devcontainers/base:noble",
    "features": {
      "t3code-server": {
        "packageSource": "github:wyrd-company/t3code",
        "version": "0.0.37-wyrd.1"
      }
    }
  }
}
